#!/bin/sh
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT HUP INT TERM
mkdir "$scratch/cache"
xcrun swiftc -module-cache-path "$scratch/cache" -o "$scratch/verify-take" \
    "$root/FingerBallCapture/Models/Take.swift" \
    "$root/FingerBallCapture/Capture/VideoFrames.swift" \
    "$root/FingerBallCapture/Capture/SavedFrameIndex.swift" \
    "$root/scripts/VerifyTake.swift"
"$scratch/verify-take" "$@"
